#!/usr/bin/env bash
#
# Reconcile the running gateway with gateway/ in the HomeLab repository.
#
# This exists so gateway config is not delivered by cloud-init. Editing a
# cloud-init template replaces the VM -- pm-cloudinit-vm has no
# ignore_changes on `initialization`, which is what destroyed the
# cmd_and_ctrl VM on 2026-09-10 -- and a reverse proxy's config changes far
# too often to pay a rebuild each time. Worse, a rebuild discards Caddy's
# certificate store, and Let's Encrypt allows only 5 duplicate certificates
# per week, so a few afternoons of iteration would end with no working TLS.
#
# Pull rather than push: the repository is public, so the host needs no
# credentials and CI needs no SSH access into the network. Nothing inbound.
#
# Run by gateway-sync.timer. Safe to run by hand at any time.

set -euo pipefail

REPO_DIR=/opt/gateway/repo
LIVE_DIR=/opt/gateway/live
SRC_DIR="${REPO_DIR}/gateway"

log() { echo "[gateway-sync] $*"; }

# --- Fetch -------------------------------------------------------------------
# reset --hard, not pull: the checkout is a cache of origin/main, never a
# place anyone edits. A merge conflict here would wedge the timer silently.
git -C "${REPO_DIR}" fetch --quiet --depth 1 origin main
git -C "${REPO_DIR}" reset --quiet --hard FETCH_HEAD

if [[ ! -d "${SRC_DIR}" ]]; then
  log "ERROR: ${SRC_DIR} missing from the checkout; refusing to sync"
  exit 1
fi

# --- Self-update -------------------------------------------------------------
# This script is installed to /usr/local/bin by cloud-init, which runs exactly
# once. Without this block, fixing the sync itself means rebuilding the VM --
# and rebuilding to fix the thing whose whole purpose is to avoid rebuilding
# is a trap worth closing permanently.
#
# mv, not install, over the live path: rename is atomic and allocates a new
# inode, so the bash process currently executing this file keeps reading the
# old one through its open descriptor. Writing the destination in place would
# let bash read half of one version and half of another, since it reads
# scripts incrementally rather than all at once.
#
# The new version takes effect on the NEXT run, a minute later. Deliberately
# not re-exec'd: a self-replacing script that immediately runs its replacement
# turns one bad commit into a crash loop with no interval to push a fix in.
if ! cmp -s "${SRC_DIR}/bootstrap/gateway-sync" /usr/local/bin/gateway-sync; then
  install -m 0755 "${SRC_DIR}/bootstrap/gateway-sync" /usr/local/bin/.gateway-sync.new
  mv /usr/local/bin/.gateway-sync.new /usr/local/bin/gateway-sync
  log "gateway-sync updated; the next run will use it"
fi

units_changed=0
for f in gateway-sync.service gateway-sync.timer; do
  if ! cmp -s "${SRC_DIR}/bootstrap/${f}" "/etc/systemd/system/${f}"; then
    install -m 0644 "${SRC_DIR}/bootstrap/${f}" "/etc/systemd/system/${f}"
    units_changed=1
    log "${f} updated"
  fi
done
if [[ "${units_changed}" -eq 1 ]]; then
  systemctl daemon-reload
fi

# --- Validate BEFORE anything becomes live -----------------------------------
# An invalid Caddyfile does not degrade the gateway, it stops it: Caddy
# refuses to start and every internal name goes dark at once. Checking the
# incoming file with the Caddy that is already running costs a second and
# turns that into a no-op plus a log line.
#
# Skipped when no Caddy is running yet (first boot), because there is nothing
# to validate with and nothing to break.
if docker ps --format '{{.Names}}' | grep -qx caddy; then
  if ! docker exec -i caddy caddy validate --adapter caddyfile --config - \
      < "${SRC_DIR}/Caddyfile" >/dev/null 2>&1; then
    log "ERROR: incoming Caddyfile is invalid; keeping the current config"
    docker exec -i caddy caddy validate --adapter caddyfile --config - \
      < "${SRC_DIR}/Caddyfile" || true
    exit 1
  fi
fi

# --- Publish -----------------------------------------------------------------
# Copy out of the checkout rather than running compose inside it. Homepage
# creates any config file it does not find, and those writes would otherwise
# land in a git working tree and make the next `reset --hard` destructive.
mkdir -p "${LIVE_DIR}"
rsync -a --delete \
  --exclude 'bootstrap/' \
  --exclude 'README.md' \
  "${SRC_DIR}/" "${LIVE_DIR}/"

cd "${LIVE_DIR}"

# --remove-orphans so a service deleted from the compose file actually stops,
# rather than lingering and still holding its port.
docker compose pull --quiet
docker compose up -d --remove-orphans

# --- Reload Caddy ------------------------------------------------------------
# `docker compose up -d` is NOT enough on its own, and assuming it was cost a
# long debugging session. Compose compares the service DEFINITION -- image,
# env, ports, volume mappings -- and the Caddyfile is a bind mount, so editing
# it changes no part of that definition. Compose sees an up-to-date container
# and does nothing. Caddy, meanwhile, reads its Caddyfile exactly once at
# startup.
#
# The result is a config change that lands on disk, reports success, and never
# reaches the running process. It is invisible in the worst way: the file on
# the host is correct, git is correct, the sync logs a clean run, and the
# gateway keeps serving the previous config indefinitely. New sites never get
# certificates because Caddy does not know they exist, which presents as a TLS
# handshake failure rather than as anything resembling a stale config.
#
# `caddy reload` is graceful -- it swaps config without dropping connections
# and without restarting the container, so the certificate store in the
# caddy_data volume is untouched.
if docker ps --format '{{.Names}}' | grep -qx caddy; then
  if docker exec caddy caddy reload \
      --config /etc/caddy/Caddyfile --adapter caddyfile 2>/dev/null; then
    log "caddy reloaded"
  else
    # The incoming Caddyfile was validated above, so a failure here is not a
    # bad config -- it is the admin API being unreachable or the container
    # being unhealthy. Restarting is the honest fallback; the alternative is
    # continuing to serve a config nobody can see.
    log "WARNING: caddy reload failed; restarting the container"
    docker compose restart caddy
  fi
fi

log "synced to $(git -C "${REPO_DIR}" rev-parse --short HEAD)"
