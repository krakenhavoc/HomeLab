[Unit]
Description=Reconcile the NetCrawl web host with netcrawl/ in the HomeLab repo
Documentation=https://github.com/krakenhavoc/HomeLab/blob/main/netcrawl/README.md
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/netcrawl-sync
TimeoutStartSec=15min

# A failed sync must not take the game down: the script validates the
# incoming compose file first and exits non-zero without touching the running
# stack. Failures show up in `systemctl status netcrawl-sync`.
SuccessExitStatus=0

[Install]
WantedBy=multi-user.target
