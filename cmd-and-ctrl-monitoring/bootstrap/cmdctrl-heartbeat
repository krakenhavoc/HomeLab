#!/usr/bin/env bash
#
# Tell cmd_and_ctrl's off-site cron that the monitor is alive
# (cmd_and_ctrl ADR 0123 §8).
#
# Nothing outside the house can see this VM, so the VM reports out instead.
# When Prometheus and Alertmanager are both ready, it writes the current Unix
# time to the repo-level Actions variable CMDCTRL_MONITORING_HEARTBEAT on
# krakenhavoc/cmd_and_ctrl. That repo's GitHub cron alerts when the value is
# more than 20 minutes old. A beat therefore means "the monitor can alert";
# a stack that is up but not ready sends nothing.
#
# The contract (fixed; the cron reads it):
#   variable  CMDCTRL_MONITORING_HEARTBEAT, repo level, on krakenhavoc/cmd_and_ctrl
#   value     Unix epoch seconds, as a decimal string
#
# The token is a fine-grained PAT scoped to cmd_and_ctrl with only
# "Variables: Read and write". cloud-init writes it to TOKEN_FILE (0600 root).
# It is never put on a command line and never logged: curl reads the header
# from a 0600 file under /run, and only HTTP status codes are printed.
#
# No token file: log it and exit 0 without a beat; the cron then reports the
# heartbeat lost. An expired token works the same way (401, no beat).
#
# Run by cmdctrl-heartbeat.timer every 5 minutes. Safe to run by hand.

set -euo pipefail

REPO=krakenhavoc/cmd_and_ctrl
VARIABLE=CMDCTRL_MONITORING_HEARTBEAT
API=https://api.github.com
TOKEN_FILE=/etc/monitoring/heartbeat_token
TEXTFILE_DIR=/var/lib/monitoring/textfile

log() { echo "[cmdctrl-heartbeat] $*"; }

if [[ ! -s "${TOKEN_FILE}" ]]; then
  log "no token at ${TOKEN_FILE}; not sending a heartbeat (see cmd-and-ctrl-monitoring/README.md)"
  exit 0
fi

# --- Is the monitor able to alert? -------------------------------------------
# Over each container's own loopback: neither port is published on the host.
ready() {
  docker exec "$1" wget -q -O /dev/null "http://127.0.0.1:$2/-/ready" 2> /dev/null
}
if ! ready prometheus 9090; then
  log "Prometheus is not ready; no heartbeat"
  exit 1
fi
if ! ready alertmanager 9093; then
  log "Alertmanager is not ready; no heartbeat"
  exit 1
fi

# --- Beat ----------------------------------------------------------------------
umask 077
work=$(mktemp -d /run/cmdctrl-heartbeat.XXXXXX)
trap 'rm -rf "${work}"' EXIT

token=$(< "${TOKEN_FILE}")
token=${token//[$'\r\n\t ']/}
# printf is a builtin, so the token never reaches a process's argv.
printf 'Authorization: Bearer %s\n' "${token}" > "${work}/auth"
unset token

now=$(date +%s)
printf '{"name":"%s","value":"%s"}' "${VARIABLE}" "${now}" > "${work}/body"

call() {
  local method=$1 url=$2
  curl -sS -o /dev/null -w '%{http_code}' --max-time 20 \
    -X "${method}" \
    -H @"${work}/auth" \
    -H 'Accept: application/vnd.github+json' \
    -H 'X-GitHub-Api-Version: 2022-11-28' \
    -H 'Content-Type: application/json' \
    --data-binary @"${work}/body" \
    "${url}" || true # on a network error -w still prints 000
}

code=$(call PATCH "${API}/repos/${REPO}/actions/variables/${VARIABLE}")
if [[ "${code}" == "404" ]]; then
  # The first beat ever, or the variable was deleted: create it.
  code=$(call POST "${API}/repos/${REPO}/actions/variables")
  [[ "${code}" == "201" ]] && log "created ${VARIABLE}"
fi
case "${code}" in
  204 | 201) ;;
  *)
    log "GitHub answered ${code}; no heartbeat (401: token expired or revoked; 403: missing Variables permission)"
    exit 1
    ;;
esac

# --- Record it -----------------------------------------------------------------
umask 022
mkdir -p "${TEXTFILE_DIR}"
tmp=$(mktemp "${TEXTFILE_DIR}/.cmdctrl_heartbeat.XXXXXX")
{
  echo "# HELP cmdctrl_monitoring_heartbeat_last_success_timestamp_seconds Unix time of the last heartbeat accepted by GitHub."
  echo "# TYPE cmdctrl_monitoring_heartbeat_last_success_timestamp_seconds gauge"
  echo "cmdctrl_monitoring_heartbeat_last_success_timestamp_seconds ${now}"
} > "${tmp}"
chmod 0644 "${tmp}"
mv -f "${tmp}" "${TEXTFILE_DIR}/cmdctrl_heartbeat.prom"

log "beat ${now}"
