[Unit]
Description=Reconcile the wkjp stack with wkjp/ in the HomeLab repo
Documentation=https://github.com/krakenhavoc/HomeLab/blob/main/wkjp/README.md
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/wkjp-sync

# A failed sync must not take the app down: the script validates the
# incoming compose file first and exits non-zero without touching the running
# stack. Failures show up in `systemctl status wkjp-sync`.
SuccessExitStatus=0

[Install]
WantedBy=multi-user.target
