#cloud-config
# First-boot bootstrap for the lab gateway host. See docs/gateway.md.
#
# THIS FILE DELIBERATELY CONTAINS NO GATEWAY CONFIG. It installs Docker,
# writes the one secret the stack needs, clones the repo and hands over to
# gateway-sync. The Caddyfile, compose file and portal config live in
# gateway/ in the repository and reach the host from there.
#
# The reason is structural, not stylistic: pm-cloudinit-vm has no
# lifecycle.ignore_changes on `initialization`, so editing this template
# replaces the VM. That is the mechanism that destroyed the cmd_and_ctrl VM
# and its data disk on 2026-09-10. A reverse proxy's config changes weekly,
# and every one of those edits would rebuild the host and discard Caddy's
# certificate store -- with Let's Encrypt allowing 5 duplicate certificates
# per week, a few afternoons of that ends with no working TLS.
#
# So: things that change when the MACHINE changes go here. Things that change
# when the SERVICE changes go in gateway/.
preserve_hostname: false
hostname: ${hostname}

apt:
  sources:
    docker.list:
      source: deb [arch=amd64] https://download.docker.com/linux/ubuntu $RELEASE stable
      keyid: 9DC858229FC7DD38854AE2D88D81803C0EBFCD88
package_update: true
package_upgrade: true
packages:
  - qemu-guest-agent
  - docker-ce
  - docker-ce-cli
  - docker-compose-plugin
  - git
  - rsync

users:
  # sudo only. NOT "sudo, docker", which is the obvious thing to write and
  # silently breaks login entirely: cloud-init creates users in the init
  # stage, packages install in the config stage, so the docker group does not
  # exist yet and `useradd --groups sudo,docker` fails. cloud-init logs it and
  # moves on, so every later step still runs as root and the host looks
  # healthy -- while having no login user at all and no SSH access.
  # Membership is granted in runcmd instead, after Docker is installed.
  - name: ${admin_username}
    gecos: "PFE Admin"
    groups: sudo
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    ssh_authorized_keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAILZzMMk21CqtHkvN3b0euByxFNR042KCcot981yCwUlu

write_files:
  # The only secret on the box. Kept out of the repository, which is public,
  # and out of gateway/ for the same reason.
  #
  # 0600 root:root: every process that needs it is a container Docker starts
  # as root, so nothing is gained by widening it.
  - path: /etc/gateway/caddy.env
    owner: root:root
    permissions: '0600'
    content: |
      CF_DNS_API_TOKEN=${cloudflare_api_token}

  # Homepage widget credentials, as HOMEPAGE_VAR_* lines. One variable holding
  # the whole file rather than one Terraform variable per token: there are six
  # of them, none is referenced anywhere else, and six secrets plus six
  # variables plus six workflow lines is a lot of plumbing for values that
  # only ever travel together.
  #
  # Written even when empty so the file always exists.
  - path: /etc/gateway/homepage.env
    owner: root:root
    permissions: '0600'
    content: |
      ${indent(6, homepage_widget_env)}

runcmd:
  - systemctl enable --now qemu-guest-agent
  - systemctl enable --now docker

  # Now that docker-ce has created the group, the admin can join it. Doing
  # this here rather than in `users:` is what keeps the account from failing
  # to be created at all -- see the note there.
  - usermod -aG docker ${admin_username}

  # Shallow clone: this is a config cache, not a working copy, and nothing on
  # the host ever needs the history.
  - mkdir -p /opt/gateway
  - git clone --depth 1 --branch main https://github.com/krakenhavoc/HomeLab.git /opt/gateway/repo

  - install -m 0755 /opt/gateway/repo/gateway/bootstrap/gateway-sync /usr/local/bin/gateway-sync
  - install -m 0644 /opt/gateway/repo/gateway/bootstrap/gateway-sync.service /etc/systemd/system/gateway-sync.service
  - install -m 0644 /opt/gateway/repo/gateway/bootstrap/gateway-sync.timer /etc/systemd/system/gateway-sync.timer
  - systemctl daemon-reload

  # Run the reconcile once synchronously so the host comes up already
  # serving, rather than waiting for the timer's first tick. Everything after
  # this -- every Caddyfile edit, every new service -- arrives via the timer.
  - systemctl enable --now gateway-sync.timer
  - systemctl start gateway-sync.service

final_message: |
  ${hostname} is up at ${ipv4_address}.
  Gateway config is delivered by gateway-sync from the HomeLab repo, not from
  cloud-init. Portal: https://labxp.io
