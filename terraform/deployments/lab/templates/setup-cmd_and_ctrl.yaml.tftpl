#cloud-config
# Host prep only. Application artifacts (server binary, client dist, scripts)
# are pushed by the cmd_and_ctrl repo's CD pipeline via SSH as ${admin_username}.
#
# One template, two VMs. Production and the develop preview differ only in
# hostname, fqdn, tokens, and CMDCTRL_ENV — same paths, same service name,
# same user, same port. That is deliberate: CD then deploys to both with an
# identical recipe and only the target host changes, so a dev deploy cannot
# accidentally be shaped differently from the prod one it is rehearsing.
preserve_hostname: false
hostname: ${hostname}
ssh_pwauth: false
package_update: true
package_upgrade: true
packages:
  - qemu-guest-agent
  - curl
  - ca-certificates
  - apt-transport-https
  - gnupg
  - rsync

users:
  - name: ${admin_username}
    gecos: "cmd_and_ctrl Admin"
    groups: sudo
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    ssh_authorized_keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAILZzMMk21CqtHkvN3b0euByxFNR042KCcot981yCwUlu
  - name: cmdctrl
    system: true
    shell: /usr/sbin/nologin
    homedir: /var/lib/cmd_and_ctrl
    no_create_home: true

write_files:
  # Env file for the server. Created root:root first; chowned to root:cmdctrl
  # in runcmd after the cmdctrl user exists.
  #
  # CMDCTRL_ENV is the single gate for every dev-only feature (cmd_and_ctrl
  # ADR 0023). Written explicitly on BOTH environments rather than relying on
  # the prod default, so the file always states which deployment it is. CD
  # rewrites this key on every deploy, so a hand edit cannot outlive a restart.
  #
  # CMDCTRL_PUBLIC_BASE_URL and the Discord three-tuple are provisioned by the
  # cmd_and_ctrl CD pipeline, not here.
  #
  # CMDCTRL_GITHUB_TOKEN is seeded here only when a token is supplied, so a
  # rebuilt VM boots with the bug-report button live instead of waiting for the
  # next CD run. CD still owns the steady-state value and overwrites it. Left
  # empty the line is not written at all, which is what the develop preview
  # does -- it has no business filing issues against the production repo.
  - path: /etc/cmd_and_ctrl/env
    permissions: "0640"
    owner: root:root
    content: |
      CMDCTRL_ENV=${cmdctrl_env}
      CMDCTRL_ADMIN_TOKEN=${admin_token}
      CMDCTRL_ADDR=127.0.0.1:8080
      CMDCTRL_DATA_DIR=/var/lib/cmd_and_ctrl/data
      CMDCTRL_ALLOWED_ORIGINS=${fqdn}
      # Cloudflare terminates TLS at the edge and cloudflared forwards plain
      # HTTP to Caddy, so every request reaches the Go server from 127.0.0.1.
      # Without this the per-IP rate limiters key every client in the world to
      # the same bucket — see the avatar limiter note in lobby/http.go.
      CMDCTRL_TRUST_FORWARDED=1
      # The browser's connection IS https (Cloudflare edge), even though this
      # origin speaks http, so session cookies should carry Secure.
      CMDCTRL_SECURE_COOKIES=1%{ if github_token != "" }
      CMDCTRL_GITHUB_TOKEN=${github_token}%{ endif }

  # Caddyfile — static client + reverse proxy to Go server.
  # HTTP-only: Cloudflare Tunnel terminates TLS at the edge and forwards
  # plain HTTP to this origin, so Caddy does not need its own cert.
  #
  # The @api matcher is ONE `path` directive with many arguments: multiple
  # arguments to a single matcher are OR'ed, whereas repeating the directive
  # would AND them and match nothing. Keep it in sync with the routes
  # registered in server/internal/lobby/http.go and client/vite.config.ts —
  # a route missing here is silent, because the client gets index.html back,
  # fails to parse it, and simply hides the feature.
  #
  # Do NOT add `header_up Host`. Caddy forwards the original Host by default
  # and the game server's WebSocket CheckOrigin compares the Origin header's
  # host against the request Host; rewriting Host to the upstream 403s every
  # /ws upgrade while ordinary HTTP keeps working.
  - path: /etc/caddy/Caddyfile
    permissions: "0644"
    owner: root:root
    content: |
      {
        admin off
        auto_https off
      }

      :80 {
        encode zstd gzip

        @api path /ws /healthz /config /me /logout /games /games/* /cards/* /admin/* /auth/* /avatars/* /bugreport /bugreport/* /dev /dev/*
        reverse_proxy @api 127.0.0.1:8080

        root * /var/www/cmdctrl-client
        file_server
      }

  # systemd unit — Go server
  - path: /etc/systemd/system/cmd-and-ctrl.service
    permissions: "0644"
    content: |
      [Unit]
      Description=cmd_and_ctrl game server (${cmdctrl_env})
      After=network-online.target var-lib-cmd_and_ctrl.mount
      Wants=network-online.target
      RequiresMountsFor=/var/lib/cmd_and_ctrl

      [Service]
      Type=simple
      User=cmdctrl
      Group=cmdctrl
      WorkingDirectory=/opt/cmd_and_ctrl/server
      EnvironmentFile=/etc/cmd_and_ctrl/env
      ExecStart=/opt/cmd_and_ctrl/server/bin/cmd_and_ctrl-server
      Restart=on-failure
      RestartSec=5
      TimeoutStopSec=30
      SuccessExitStatus=0 143
      NoNewPrivileges=true
      ProtectSystem=strict
      ProtectHome=true
      PrivateTmp=true
      ReadWritePaths=/var/lib/cmd_and_ctrl

      [Install]
      WantedBy=multi-user.target

  # systemd unit + timer — weekly Scryfall dump refresh
  - path: /etc/systemd/system/cmd-and-ctrl-scryfall.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Refresh Scryfall card dump for cmd_and_ctrl
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=oneshot
      User=cmdctrl
      Group=cmdctrl
      EnvironmentFile=/etc/cmd_and_ctrl/env
      ExecStart=/opt/cmd_and_ctrl/scripts/scryfall-refresh.sh
  - path: /etc/systemd/system/cmd-and-ctrl-scryfall.timer
    permissions: "0644"
    content: |
      [Unit]
      Description=Weekly Scryfall dump refresh for cmd_and_ctrl

      [Timer]
      OnCalendar=Sun 05:00
      OnBootSec=15min
      Persistent=true
      Unit=cmd-and-ctrl-scryfall.service

      [Install]
      WantedBy=timers.target

runcmd:
  # --- Data disk: format + mount at /var/lib/cmd_and_ctrl ---
  # OS disk is virtio0 (/dev/vda), data disk is virtio1 (/dev/vdb).
  # Runs under /bin/sh (dash on Ubuntu) — no bash-only flags like `pipefail`.
  # No shell brace-expansion anywhere in here. This file is a Terraform
  # template, so a bare dollar-brace sequence is interpolated away at plan
  # time; shell variables are referenced as "$DATA_DEV", without braces.
  # (Terraform caught this comment itself doing it on the first validate.)
  - |
    set -eu
    DATA_DEV=/dev/vdb
    if ! blkid "$DATA_DEV" >/dev/null 2>&1; then
      mkfs.ext4 -L cmdctrl-data "$DATA_DEV"
    fi
    mkdir -p /var/lib/cmd_and_ctrl
    UUID=$(blkid -s UUID -o value "$DATA_DEV")
    grep -q "$UUID" /etc/fstab || echo "UUID=$UUID /var/lib/cmd_and_ctrl ext4 defaults,noatime 0 2" >> /etc/fstab
    mount -a
    mkdir -p /var/lib/cmd_and_ctrl/data/scryfall /var/lib/cmd_and_ctrl/data/images
    chown -R cmdctrl:cmdctrl /var/lib/cmd_and_ctrl

  # --- Fix env file ownership now that cmdctrl user exists ---
  - chown root:cmdctrl /etc/cmd_and_ctrl/env

  # --- CD-writable paths. ${admin_username} rsyncs artifacts here. ---
  - mkdir -p /opt/cmd_and_ctrl/server/bin /opt/cmd_and_ctrl/scripts /var/www/cmdctrl-client
  - chown -R ${admin_username}:${admin_username} /opt/cmd_and_ctrl

  # --- Caddy (official repo) ---
  # --force-confold is required because write_files already created
  # /etc/caddy/Caddyfile; without it dpkg hangs on a conffile prompt and
  # DEBIAN_FRONTEND=noninteractive does not suppress that specific prompt.
  - curl -fsSL https://dl.cloudsmith.io/public/caddy/stable/gpg.key | gpg --dearmor -o /usr/share/keyrings/caddy-stable-archive-keyring.gpg
  - curl -fsSL https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt | tee /etc/apt/sources.list.d/caddy-stable.list
  - apt-get update
  - DEBIAN_FRONTEND=noninteractive apt-get install -y -o Dpkg::Options::=--force-confold caddy
  - chown -R ${admin_username}:caddy /var/www/cmdctrl-client
  - chmod 0755 /var/www/cmdctrl-client

  # --- cloudflared (official repo) ---
  - curl -fsSL https://pkg.cloudflare.com/cloudflare-main.gpg | tee /usr/share/keyrings/cloudflare-main.gpg >/dev/null
  - echo "deb [signed-by=/usr/share/keyrings/cloudflare-main.gpg] https://pkg.cloudflare.com/cloudflared noble main" > /etc/apt/sources.list.d/cloudflared.list
  - apt-get update
  - DEBIAN_FRONTEND=noninteractive apt-get install -y cloudflared

  # --- Enable services ---
  # cmd-and-ctrl.service and the scryfall timer will fail until CD pushes the
  # binary and script. Restart=on-failure handles the retry loop.
  - systemctl daemon-reload
  - systemctl enable --now caddy
  - systemctl enable cmd-and-ctrl.service
  - systemctl enable --now cmd-and-ctrl-scryfall.timer
  - cloudflared service install ${tunnel_token}

power_state:
  mode: reboot
  message: "Rebooting after cloud-init final stage"
  timeout: 30
  condition: true

final_message: |
  ${hostname} host is ready (${cmdctrl_env}). Caddy on :80, cloudflared connector registered.
  Deploy artifacts from cmd_and_ctrl CD pipeline:
    rsync server binary to /opt/cmd_and_ctrl/server/bin/cmd_and_ctrl-server
    rsync client dist/ to /var/www/cmdctrl-client/
    rsync scripts/ to /opt/cmd_and_ctrl/scripts/
    sudo systemctl restart cmd-and-ctrl
  Public hostname ${fqdn} is managed by Terraform (cloudflare_zero_trust_tunnel_cloudflared_config).
